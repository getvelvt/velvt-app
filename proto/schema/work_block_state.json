{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Direction: Rust to Swift. Local IPC only. Behavioral copy and evidence are authored/aggregated in Rust.",
  "type": "object",
  "required": [
    "type",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "work_block_state"
    },
    "payload": {
      "type": "object",
      "required": [
        "state_version",
        "phase",
        "block_id",
        "intention",
        "purpose",
        "intensity",
        "planned_duration_seconds",
        "elapsed_duration_seconds",
        "remaining_duration_seconds",
        "started_at",
        "analysis_ended_at",
        "ends_at",
        "paused_at",
        "recovered_after_restart",
        "current_category",
        "anchor_category",
        "classification_status",
        "confidence",
        "status_line",
        "result"
      ],
      "properties": {
        "state_version": {
          "const": 1
        },
        "phase": {
          "enum": [
            "idle",
            "active",
            "paused",
            "completed",
            "abandoned",
            "expired"
          ]
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "intention": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "deep_work",
            "study",
            "creative_practice",
            "healthy_tech_use",
            "work_life_boundary"
          ]
        },
        "intensity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "light",
            "medium",
            "intense"
          ]
        },
        "planned_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "elapsed_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "remaining_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "analysis_ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "paused_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recovered_after_restart": {
          "type": "boolean"
        },
        "current_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_category": {
          "$comment": "Protocol 31. The broad category the drift gate treats as this block's anchor. Since drift policy v6 (2026-10-15, no wire change) it is the work category (FOCUS_WORK, REFERENCE, TASK_MANAGEMENT or COMMUNICATION) with the most confidently observed, closed time so far, never PASSIVE_CONSUMPTION, SOCIAL_FEED or SYSTEM; before v6 it was any category with the most such time. The same value the gate compares departures against and records on an offer. Null when no block is active or paused, and until a confident observation of a work category has closed. A category label only, never an app identity, title, URL, or intention. Pre-31 payloads omit the key.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "classification_status": {
          "enum": [
            "classified",
            "ambiguous",
            "unclassified"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "status_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "rating_prompt": {
          "$comment": "Protocol 38. The question after a block. Present only on the snapshot of an ended block (completed, abandoned or expired), only while the question about that block can be answered, and only while the question has stayed on since before that block started (turning it off and on again does not bring it back). Omitted otherwise, and on every active or paused block. Rust decides and writes every word; Swift renders it verbatim. `presentation` `question`: before an answer or a Not now, the question sits above the result card and the card's observation and numbers stay hidden. `link`: after Not now, the card shows with `link` under it, which reopens the question. After an answer, Swift shows `acknowledgement`, then the card. `expires_at` is two hours after the block ended or the next block's start, whichever came first. Never a notification.",
          "type": "object",
          "required": [
            "block_id",
            "prompt_version",
            "presentation",
            "question",
            "options",
            "not_now",
            "footnote",
            "acknowledgement",
            "link",
            "expires_at"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "format": "uuid"
            },
            "prompt_version": {
              "type": "integer",
              "minimum": 1
            },
            "presentation": {
              "enum": [
                "question",
                "link"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "options": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "answer",
                  "label"
                ],
                "properties": {
                  "answer": {
                    "enum": [
                      "all",
                      "most",
                      "half",
                      "less_than_half",
                      "little"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "additionalProperties": false
              }
            },
            "not_now": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "footnote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "acknowledgement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "link": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "rating_opt_in": {
          "$comment": "Protocol 38. The one-time invitation to turn the question after a block on. Present only on the snapshot of an ended block the question would have covered (five minutes or more, started at or after the end of this Mac's first 14 days of blocks) while the question has never been turned on and the invitation has never been answered. Either button sends respond_rating_opt_in: Turn on with turn_on true, Not now with false, after which it never appears again. Omitted otherwise.",
          "type": "object",
          "required": [
            "body",
            "turn_on",
            "not_now"
          ],
          "properties": {
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "turn_on": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "not_now": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "additionalProperties": false
        },
        "active_intervention": {
          "$comment": "Present only while an offer is unanswered. Rust authors the copy; Swift renders it verbatim. `salience` is quiet when the user pushed a recent offer away — the card still renders, the notification is not sent.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "action_id",
                "title",
                "body",
                "anchor_category",
                "switch_count",
                "window_seconds",
                "offered_at",
                "salience"
              ],
              "properties": {
                "action_id": {
                  "const": "protect_next_10"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "anchor_category": {
                  "type": "string",
                  "minLength": 1
                },
                "switch_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "window_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "offered_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "salience": {
                  "enum": [
                    "normal",
                    "quiet"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "planned_duration_seconds",
                "elapsed_duration_seconds",
                "longest_uninterrupted_seconds",
                "switch_away_count",
                "recovery_count",
                "confidence",
                "coverage",
                "coverage_ratio",
                "safe_evidence_category",
                "observation",
                "next_action"
              ],
              "properties": {
                "planned_duration_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "elapsed_duration_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "longest_uninterrupted_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "switch_away_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "recovery_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "confidence": {
                  "enum": [
                    "none",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "coverage": {
                  "enum": [
                    "insufficient",
                    "partial",
                    "good"
                  ]
                },
                "coverage_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "safe_evidence_category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "next_action": {
                  "type": "object",
                  "required": [
                    "action_id",
                    "label",
                    "duration_seconds"
                  ],
                  "properties": {
                    "action_id": {
                      "const": "protect_next_10",
                      "enum": [
                        "protect_next_10",
                        "soft_restart_10"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "duration_seconds": {
                      "const": 600
                    }
                  },
                  "additionalProperties": false
                },
                "dnd_outcomes": {
                  "$comment": "Optional; omitted when empty. completed_under_dnd appears at most once and marks a success. Each delivery_suppressed_dnd entry is one mid-block nudge held because DND was active — never delivered by another channel, reconciled after the block as a count only.",
                  "type": "array",
                  "items": {
                    "enum": [
                      "completed_under_dnd",
                      "delivery_suppressed_dnd"
                    ]
                  },
                  "maxItems": 8
                },
                "reconciliation": {
                  "$comment": "Optional. At most one Rust-authored calm post-block line noting what was held. Analyst voice; no reference to what the user missed.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
