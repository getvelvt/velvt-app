{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This alert contains only safe diagnostic control data.",
  "title": "Privacy Violation Alert",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "privacy_violation_alert" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "const": "raw_field_rejected" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
