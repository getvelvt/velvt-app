{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This message must never contain raw identifying user data. The message field must be safe for display; it must not echo credentials or tokens.",
  "title": "Auth Failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "auth_failure" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["invalid_credentials", "network_error", "server_error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
