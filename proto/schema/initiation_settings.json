{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Direction: Rust to Swift. The current Rust-owned initiation-invitation setting.",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "initiation_settings" },
    "payload": {
      "type": "object",
      "required": ["invitations_enabled"],
      "properties": {
        "invitations_enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
