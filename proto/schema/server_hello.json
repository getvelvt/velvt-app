{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Server Hello",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "server_hello" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version"],
      "properties": {
        "protocol_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
