{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Direction: Swift to Rust. Credentials are opaque auth-protocol values. They must never be logged, stored in SQLite, or included in upload payloads.",
  "title": "Log In",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "log_in" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 }
      }
    }
  }
}
