{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This message carries only a day count; no raw user data.",
  "title": "Request Latest History",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "request_latest_history" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    }
  }
}
