{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Malformed Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "malformed_message" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["invalid_message"] }
      }
    }
  }
}
