{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This message must never contain raw identifying user data.",
  "title": "Service Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "service_status" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["ready", "degraded", "upload_paused", "auth_required"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
