                 "elapsed_seconds": 1800, "covered_seconds": 1200, "coverage_class": "partial",
                 "work_anchor_share": 1.0, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.666667,
                 "recovery_ratio": 0.0, "feed_share": 0.0, "unlogged_share": 0.0,
                 "offer_delivered": 1, "offer_outcome": "accepted_action", "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 30, "origin": "manual", "hour_bucket": "afternoon", "weekend": 0}
    },
    {
      "name": "two_departures_two_returns",
      "rule": "Two switch-aways and two returns: recoveries over switch-aways is 1. The work share is the dominant work category's time (FOCUS_WORK 900), not all work time (COMMUNICATION 120 is work too), over 1080 confident seconds. Decision rows under two policies give no policy version. Planned minutes round to the nearest (1530 s is 26). 17:59:59 is afternoon.",
      "base": 1800035999,
      "block": {"started_at": 0, "ended_at": 1200, "total_paused_seconds": 0, "phase": "abandoned",
