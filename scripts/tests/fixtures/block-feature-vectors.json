{
  "about": [
    "Hand-worked answers for the block-features file of export format 7 (BLOCK_FEATURE_VERSION 1), one rule per case.",
    "Three implementations are held to them. rust-service/src/work_block/block_feature_vectors.rs replays each case through the app's own end-of-block result (aggregate_result, block_result_copy, work_anchor, is_confident) and requires the `result` fields, the card branch and the two category shares. scripts/tests/block_features_test.sh requires every column from the exporter's SQL (export_cohort_evidence.sh) and from analyze_cohort.py's `block_features`, which restates it.",
    "Times are seconds after `base`. Observations are [start, end, category, status, confidence]; an end of null is a row still open. `covered_seconds` is what the raw activity stream covered with confident activity while the block ran, which the app measures at the block's end and which no export can recompute. `result` holds the fields of the stored result payload the exporter reads. `decisions` are the policy versions of the block's decision-log rows; `offer` is its work_block_intervention outcome. Hour bucket and weekend in `expect` are worked out in UTC. `zones` holds them, [hour_bucket, weekend], for each case's start in two other time zones, worked out from the zone rules: the tests run the exporter and analyze_cohort.py's block_features under UTC and under each of these, and both must give the local answer.",
    "`card_anchor_is_work` says whether the category the card's sentence is about (the result's safe_evidence_category, the most confident time in any category) is a work category. It is empty when the card has nothing honest to say."
  ],
  "block_feature_version": 1,
  "cases": [
    {
      "name": "stayed",
      "rule": "One confident work row and an unobserved final dwell: the card says stayed, every confident second is work, and the 300 s with no row is in no share.",
      "base": 1800000000,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 1500, "FOCUS_WORK", "classified", "high"]],
      "covered_seconds": 1500,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "good", "coverage_ratio": 0.8333333333333334,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 1500,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [6, 6],
      "offer": null,
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "stayed", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1800, "covered_seconds": 1500, "coverage_class": "good",
                 "work_anchor_share": 1.0, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.833333,
                 "recovery_ratio": 0.0, "feed_share": 0.0, "unlogged_share": 0.0,
                 "offer_delivered": 0, "offer_outcome": null, "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 30, "origin": "manual", "hour_bucket": "morning", "weekend": 0}
    },
    {
      "name": "came_back",
      "rule": "Work, a feed, work again: one switch-away and one return, so the card says came back; the feed's 300 s is the feed share; switch-aways per covered hour is 1 over 1500/3600.",
      "base": 1800021600,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": "study", "intensity": "light", "origin": "invitation"},
      "observations": [[0, 600, "FOCUS_WORK", "classified", "high"],
                       [600, 900, "SOCIAL_FEED", "classified", "high"],
                       [900, 1500, "FOCUS_WORK", "classified", "high"]],
      "covered_seconds": 1500,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "good", "coverage_ratio": 0.8333333333333334,
                 "switch_away_count": 1, "recovery_count": 1, "longest_uninterrupted_seconds": 600,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [6],
      "offer": "returned",
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "came_back", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1800, "covered_seconds": 1500, "coverage_class": "good",
                 "work_anchor_share": 0.8, "switch_aways_per_covered_hour": 2.4, "longest_run_share": 0.333333,
                 "recovery_ratio": 1.0, "feed_share": 0.2, "unlogged_share": 0.0,
                 "offer_delivered": 1, "offer_outcome": "returned", "purpose": "study", "intensity": "light",
                 "planned_minutes": 30, "origin": "invitation", "hour_bucket": "afternoon", "weekend": 0}
    },
    {
      "name": "ended_elsewhere",
      "rule": "Work, then passive consumption to the end: a switch-away and no return, so the card says ended somewhere else. Decisions all under policy 5 give 5: the column copies the block's own rows.",
      "base": 1800129600,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": "creative_practice", "intensity": "intense", "origin": "manual"},
      "observations": [[0, 900, "FOCUS_WORK", "classified", "high"],
                       [900, 1500, "PASSIVE_CONSUMPTION", "classified", "medium"]],
      "covered_seconds": 1500,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "good", "coverage_ratio": 0.8333333333333334,
                 "switch_away_count": 1, "recovery_count": 0, "longest_uninterrupted_seconds": 900,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [5, 5],
      "offer": "no_response",
      "expect": {"block_feature_version": 1, "policy_version": 5, "card_branch": "ended_elsewhere", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1800, "covered_seconds": 1500, "coverage_class": "good",
                 "work_anchor_share": 0.6, "switch_aways_per_covered_hour": 2.4, "longest_run_share": 0.5,
                 "recovery_ratio": 0.0, "feed_share": 0.4, "unlogged_share": 0.0,
                 "offer_delivered": 1, "offer_outcome": "no_response", "purpose": "creative_practice",
                 "intensity": "intense", "planned_minutes": 30, "origin": "manual",
                 "hour_bucket": "evening", "weekend": 1}
    },
    {
      "name": "low_coverage",
      "rule": "Coverage 300/1800 is under 0.25: the class is insufficient and the card has nothing honest to say. An UNLOGGED row that is also unclassified counts once in the unlogged share, beside an ambiguous row; over elapsed time that is 1200/1800. An offer withheld under demotion was not delivered, so its outcome is empty. A block with no purpose writes none.",
      "base": 1799978400,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": null, "intensity": "medium", "origin": "invitation"},
      "observations": [[0, 300, "FOCUS_WORK", "classified", "high"],
                       [300, 900, "UNLOGGED", "unclassified", "none"],
                       [900, 1500, "REFERENCE", "ambiguous", "low"]],
      "covered_seconds": 300,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "insufficient", "coverage_ratio": 0.16666666666666666,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 300,
                 "safe_evidence_category": null},
      "decisions": [6],
      "offer": "withheld_demotion",
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "low_coverage", "card_anchor_is_work": null,
                 "elapsed_seconds": 1800, "covered_seconds": 300, "coverage_class": "insufficient",
                 "work_anchor_share": 1.0, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.166667,
                 "recovery_ratio": 0.0, "feed_share": 0.0, "unlogged_share": 0.666667,
                 "offer_delivered": 0, "offer_outcome": null, "purpose": null, "intensity": "medium",
                 "planned_minutes": 30, "origin": "invitation", "hour_bucket": "night", "weekend": 0}
    },
    {
      "name": "nothing_confident",
      "rule": "No confident second at all (an ambiguous row and a SYSTEM row, which is never evidence and not unlogged): both shares are 0, no covered time makes switch-aways per covered hour 0, and the longest run is 0. A block with no decision row has no policy version. 06:00 is morning.",
      "base": 1799992800,
      "block": {"started_at": 0, "ended_at": 1500, "total_paused_seconds": 0, "phase": "expired",
                "planned_duration_seconds": 1500, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 1200, "FOCUS_WORK", "ambiguous", "low"],
                       [1200, 1500, "SYSTEM", "classified", "high"]],
      "covered_seconds": 0,
      "result": {"elapsed_duration_seconds": 1500, "coverage": "insufficient", "coverage_ratio": 0.0,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 0,
                 "safe_evidence_category": null},
      "decisions": [],
      "offer": null,
      "expect": {"block_feature_version": 1, "policy_version": null, "card_branch": "low_coverage", "card_anchor_is_work": null,
                 "elapsed_seconds": 1500, "covered_seconds": 0, "coverage_class": "insufficient",
                 "work_anchor_share": 0.0, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.0,
                 "recovery_ratio": 0.0, "feed_share": 0.0, "unlogged_share": 0.8,
                 "offer_delivered": 0, "offer_outcome": null, "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 25, "origin": "manual", "hour_bucket": "morning", "weekend": 0}
    },
    {
      "name": "card_anchor_is_not_the_work_anchor",
      "rule": "The result counts from the category with the most confident time, here PASSIVE_CONSUMPTION, so the card says stayed while the work share is 300/1200: the two are reported side by side, never reconciled. 05:59:59 is night.",
      "base": 1799992799,
      "block": {"started_at": 0, "ended_at": 1200, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1200, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 300, "FOCUS_WORK", "classified", "high"],
                       [300, 1200, "PASSIVE_CONSUMPTION", "classified", "high"]],
      "covered_seconds": 1200,
      "result": {"elapsed_duration_seconds": 1200, "coverage": "good", "coverage_ratio": 1.0,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 900,
                 "safe_evidence_category": "PASSIVE_CONSUMPTION"},
      "decisions": [6, 6],
      "offer": null,
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "stayed", "card_anchor_is_work": 0,
                 "elapsed_seconds": 1200, "covered_seconds": 1200, "coverage_class": "good",
                 "work_anchor_share": 0.25, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.75,
                 "recovery_ratio": 0.0, "feed_share": 0.75, "unlogged_share": 0.0,
                 "offer_delivered": 0, "offer_outcome": null, "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 20, "origin": "manual", "hour_bucket": "night", "weekend": 0}
    },
    {
      "name": "tied_work_categories",
      "rule": "Two work categories with equal time: the share is the same whichever wins the tie (the app takes the alphabetically first, FOCUS_WORK). A Sunday is a weekend.",
      "base": 1800172800,
      "block": {"started_at": 0, "ended_at": 1200, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1200, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 600, "REFERENCE", "classified", "high"],
                       [600, 1200, "FOCUS_WORK", "classified", "high"]],
      "covered_seconds": 1200,
      "result": {"elapsed_duration_seconds": 1200, "coverage": "good", "coverage_ratio": 1.0,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 600,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [6],
      "offer": null,
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "stayed", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1200, "covered_seconds": 1200, "coverage_class": "good",
                 "work_anchor_share": 0.5, "switch_aways_per_covered_hour": 0.0, "longest_run_share": 0.5,
                 "recovery_ratio": 0.0, "feed_share": 0.0, "unlogged_share": 0.0,
                 "offer_delivered": 0, "offer_outcome": null, "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 20, "origin": "manual", "hour_bucket": "morning", "weekend": 1}
    },
    {
      "name": "paused",
      "rule": "600 s paused: elapsed is ended - started - paused = 1800, and every share of elapsed time uses it. The two work rows either side of the pause make one run of 1200 s, as the result counts runs. 18:00 is evening.",
      "base": 1800036000,
      "block": {"started_at": 0, "ended_at": 2400, "total_paused_seconds": 600, "phase": "abandoned",
                "planned_duration_seconds": 3000, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 600, "FOCUS_WORK", "classified", "high"],
                       [1200, 1800, "FOCUS_WORK", "classified", "high"],
                       [1800, 2100, "COMMUNICATION", "classified", "high"],
                       [2100, 2400, "FOCUS_WORK", "classified", "high"]],
      "covered_seconds": 1800,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "good", "coverage_ratio": 1.0,
                 "switch_away_count": 1, "recovery_count": 1, "longest_uninterrupted_seconds": 1200,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [6],
      "offer": "was_focused",
      "expect": {"block_feature_version": 1, "policy_version": 6, "card_branch": "came_back", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1800, "covered_seconds": 1800, "coverage_class": "good",
                 "work_anchor_share": 0.833333, "switch_aways_per_covered_hour": 2.0, "longest_run_share": 0.666667,
                 "recovery_ratio": 1.0, "feed_share": 0.0, "unlogged_share": 0.0,
                 "offer_delivered": 1, "offer_outcome": "was_focused", "purpose": "deep_work", "intensity": "medium",
                 "planned_minutes": 50, "origin": "manual", "hour_bucket": "evening", "weekend": 0}
    },
    {
      "name": "low_confidence_system_and_open_rows",
      "rule": "A classified row at low confidence and a SYSTEM row are neither confident nor unlogged; a row still open counts nowhere. The result skips unconfident rows, so the work rows either side of them are one run. Coverage 1200/1800 is partial and the card still says stayed. 12:00 is afternoon.",
      "base": 1800014400,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 600, "FOCUS_WORK", "classified", "high"],
                       [600, 900, "REFERENCE", "classified", "low"],
                       [900, 1000, "SYSTEM", "classified", "high"],
                       [1000, 1600, "FOCUS_WORK", "classified", "medium"],
                       [1600, null, "SOCIAL_FEED", "classified", "high"]],
      "covered_seconds": 1200,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "partial", "coverage_ratio": 0.6666666666666666,
                 "switch_away_count": 0, "recovery_count": 0, "longest_uninterrupted_seconds": 1200,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [6, 6, 6],
      "offer": "accepted_action",
