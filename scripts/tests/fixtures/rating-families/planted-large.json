{
  "family": "PLANTED",
  "held_out": false,
  "author": "the analysis author (velvt-app PR-7)",
  "description": "The PLANTED process at a large n (20 people, about 900 primary ratings), where the estimator, not the sample, sets the error: the all-rows fit must land within 0.25 of every planted slope and recover the person-offset SD, and H2 must pass.",
  "seed": 2201,
  "replicates": 1,
  "people": 20,
  "blocks_per_person": {"median": 110, "log_sd": 0.3, "min": 40, "max": 200},
  "latent": {"mean_logit": 0.9, "person_sd": 0.6, "block_sd": 1.1},
  "rating": {
    "mode": "planted",
    "thresholds": [-2.6, -1.5, -0.6, 0.9],
    "person_offset_sd": 0.7,
    "slopes": {
      "work_anchor_share": 0.8,
      "switch_aways_per_covered_hour": -0.3,
      "log_longest_run_share": 0.3,
      "offer_delivered": -0.2
    }
  },
  "answering": {"mode": "random", "answer_probability": 0.6, "late_probability": 0.04},
  "check": {"bootstrap_replicates": 499, "lopo_replicates": 1},
  "expect": {
    "slopes_within": {
      "work_anchor_share": [0.55, 1.05],
      "switch_aways_per_covered_hour": [-0.55, -0.05],
      "log_longest_run_share": [0.05, 0.55],
      "offer_delivered": [-0.45, 0.05]
    },
    "tau_between": [0.4, 1.0],
    "h2_pass_share_at_least": 1.0
  }
}
