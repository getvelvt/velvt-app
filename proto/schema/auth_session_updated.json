{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Direction: Rust to host client. Rust refreshed or reissued the in-memory auth session; the host client must persist it in platform credential storage.",
  "title": "Auth Session Updated",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "auth_session_updated" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "access_token", "refresh_token", "expires_at"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "access_token": { "type": "string", "minLength": 1 },
        "refresh_token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "user_access_token": { "type": "string", "minLength": 1 },
        "user_refresh_token": { "type": "string", "minLength": 1 },
        "user_expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
