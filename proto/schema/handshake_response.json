{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This message type must never contain raw app names, window titles, bundle IDs, URLs, file paths, filenames, contact names, email addresses, or any other raw identifying user data.",
  "title": "Handshake Response",
  "description": "Rust service response accepting or rejecting the client's protocol version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "accepted", "server_protocol_version"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["handshake_response"]
    },
    "accepted": {
      "type": "boolean"
    },
    "server_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "rejection_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "enum": [false]
          }
        }
      },
      "then": {
        "required": ["rejection_reason"]
      },
      "else": {
        "not": {
          "required": ["rejection_reason"]
        }
      }
    }
  ]
}
