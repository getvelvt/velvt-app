                       [300, 420, "COMMUNICATION", "classified", "high"],
                       [420, 720, "FOCUS_WORK", "classified", "high"],
                       [720, 780, "SOCIAL_FEED", "classified", "medium"],
                       [780, 1080, "FOCUS_WORK", "classified", "high"]],
      "covered_seconds": 1080,
      "result": {"elapsed_duration_seconds": 1200, "coverage": "good", "coverage_ratio": 0.9,
                 "switch_away_count": 2, "recovery_count": 2, "longest_uninterrupted_seconds": 300,
                 "safe_evidence_category": "FOCUS_WORK"},
      "decisions": [5, 6],
      "offer": "dismissed",
      "expect": {"block_feature_version": 1, "policy_version": null, "card_branch": "came_back", "card_anchor_is_work": 1,
                 "elapsed_seconds": 1200, "covered_seconds": 1080, "coverage_class": "good",
                 "work_anchor_share": 0.833333, "switch_aways_per_covered_hour": 6.666667, "longest_run_share": 0.25,
