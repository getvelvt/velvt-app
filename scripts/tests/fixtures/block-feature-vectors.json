    {
      "name": "came_back_to_a_feed",
      "rule": "A feed holds the most confident time, so the card is about the feed: leaving it for work and returning to it is 'came back', and card_anchor_is_work is 0. The work share is 300/1500. Friday 20:00 UTC is Saturday 01:30 in Kolkata: a weekend there and not in UTC or Los Angeles.",
      "base": 1800043200,
      "block": {"started_at": 0, "ended_at": 1800, "total_paused_seconds": 0, "phase": "completed",
                "planned_duration_seconds": 1800, "purpose": "deep_work", "intensity": "medium", "origin": "manual"},
      "observations": [[0, 600, "SOCIAL_FEED", "classified", "high"],
                       [600, 900, "FOCUS_WORK", "classified", "high"],
                       [900, 1500, "SOCIAL_FEED", "classified", "high"]],
      "covered_seconds": 1500,
      "result": {"elapsed_duration_seconds": 1800, "coverage": "good", "coverage_ratio": 0.8333333333333334,
