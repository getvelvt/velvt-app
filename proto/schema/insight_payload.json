{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "PRIVACY: This message type must never contain raw app names, window titles, bundle IDs, URLs, file paths, filenames, contact names, email addresses, or any other raw identifying user data.",
  "title": "Insight Payload",
  "description": "Ready-to-display daily insight delivered from Rust to Swift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "date", "text", "confidence_level", "low_confidence", "generated_at"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["insight_payload"]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "text": {
      "type": "string"
    },
    "confidence_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "low_confidence": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
