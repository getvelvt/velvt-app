// Debug build — staging API, APNs sandbox.
#include "Version.xcconfig"

VELVT_API_BASE_URL = https:/$()/dev-api.getvelvt.com
VELVT_APNS_ENV = development
VELVT_SOCKET_PATH = ~/.velvt/velvt-service.sock
VELVT_PROTOCOL_VERSION = 32
VELVT_DISTRIBUTABLE = NO
VELVT_BUILD_CONFIGURATION = Debug
VELVT_UPDATER_ENABLED = NO
VELVT_UPDATE_FEED_URL =
VELVT_UPDATE_PUBLIC_ED_KEY =

// Auto-generate Info.plist from build settings instead of a literal file —
// INFOPLIST_KEY_* below is silently ignored otherwise.
GENERATE_INFOPLIST_FILE = YES
PRODUCT_NAME = Velvt
// MARKETING_VERSION and CURRENT_PROJECT_VERSION come from Version.xcconfig.
// Empty unless the release targets pass it; the Inject Custom Info.plist Keys
// phase then asks git (scripts/release_provenance.sh source-commit).
VELVT_SOURCE_COMMIT =

// Injected into the processed Info.plist at build time.
INFOPLIST_KEY_VelvtAPIBaseURL = $(VELVT_API_BASE_URL)
INFOPLIST_KEY_VelvtAPNSEnv = $(VELVT_APNS_ENV)
INFOPLIST_KEY_VelvtSocketPath = $(VELVT_SOCKET_PATH)
INFOPLIST_KEY_VelvtProtocolVersion = $(VELVT_PROTOCOL_VERSION)
INFOPLIST_KEY_VelvtClientVersion = $(MARKETING_VERSION)

// Migrated from the former literal Resources/Info.plist (see CONFIGURATION.md).
INFOPLIST_KEY_CFBundleName = Velvt
INFOPLIST_KEY_CFBundleDisplayName = Velvt
INFOPLIST_KEY_CFBundleIconFile = AppIcon
INFOPLIST_KEY_CFBundleIconName = AppIcon
INFOPLIST_KEY_LSMinimumSystemVersion = $(MACOSX_DEPLOYMENT_TARGET)
INFOPLIST_KEY_NSFocusStatusUsageDescription = Velvt reads whether Focus is active to avoid interrupting you and report notification protection accurately.
